<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Populated by eng/Download-PackageRelease.ps1 with verified upstream release assets, so a
         pinned Diginsight version can be restored before it propagates to nuget.org. Must exist
         even when empty, or restore fails with NU1301, which NoWarn cannot suppress. -->
    <add key="local-release" value="artifacts/packages" />
    <!-- The www.nuget.org endpoint is used because api.nuget.org fails TLS negotiation on the
         Windows build environment. -->
    <add key="nuget.org" value="https://www.nuget.org/api/v2/" protocolVersion="2" />
  </packageSources>
  <!-- disabledPackageSources matches by key and survives <clear />, so a user-level disable of
       "nuget.org" would otherwise silently disable the source above. -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>